	(text "diffrx rev A: RS-422 differential receiver and 12 V / 30 A pixel power distribution board"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 3.0 3.0)
			)
			(justify left bottom)
		)
		(uuid "8bf7802f-fdeb-47f7-b7ae-9f208c4d0cb6")
	)
	(text "Companion to difftx (FPP Remote pHAT). Cat5 in on J14; four WS2811 data outputs; twelve fused 12 V outputs."
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "15a97ca5-f078-4d39-a3a9-7e57c5acc4ce")
	)
	(text "RJ45 pairs (same as difftx): port1 = 1(+)/2(-), port2 = 3(+)/6(-), port3 = 4(+)/5(-), port4 = 7(+)/8(-)."
		(exclude_from_sim no)
		(at 20 29 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "0674fadb-1191-40be-bc70-44bb351c756b")
	)
	(text "J1 is the ONLY power inlet: 12 V 30 A straight from the supply. Q1-Q4 block a reversed supply; every"
		(exclude_from_sim no)
		(at 20 214 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "fd54d7ed-abcc-42e1-93c9-9b289dbaf377")
	)
	(text "output is individually fused by an MF-R400 PPTC (4 A hold / 8 A trip), so no marine fuse panel is needed."
		(exclude_from_sim no)
		(at 20 219 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "6c5167b0-c889-4515-a691-316a9132e91b")
	)
	(text "Data ports J2 (P1), J5 (P2), J8 (P3), J11 (P4). The eight INJ terminals feed power only:"
		(exclude_from_sim no)
		(at 400 20 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "3e928880-bc43-40a9-9e13-ea31661b824a")
	)
	(text "their middle pole is a no-connect so an injection pigtail's data wire never becomes a stub on the string."
		(exclude_from_sim no)
		(at 400 25 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "ed5f5bf4-9df8-4fe7-b60c-447e185c9f1e")
	)
	(text "Terminal poles are silk marked + / D / - and read left to right in that order on both rows of the board."
		(exclude_from_sim no)
		(at 400 30 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "480fec28-88ca-4f71-a4ee-67d9eaea442a")
	)
