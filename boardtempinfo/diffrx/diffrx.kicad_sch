	(text "diffrx rev C: RS-422 differential receiver and 12 V / 30 A pixel power distribution board"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 3.0 3.0)
			)
			(justify left bottom)
		)
		(uuid "ddd0030a-2a0f-45a6-9871-b9d795afc1e9")
	)
	(text "Companion to difftx (FPP Remote pHAT). Cat5 in on J14; four WS2811 data outputs; twelve fused 12 V outputs."
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "2bc87ba1-9aba-4158-9ffb-3107381fc7b6")
	)
	(text "RJ45 pairs (Falcon): port1 = 1(+)/2(-), port2 = 3(+)/6(-), port3 = 5(+)/4(-), port4 = 7(+)/8(-). difftx rev D has port 3 reversed."
		(exclude_from_sim no)
		(at 20 29 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "f2047015-004e-4ddb-aa32-59f07cf5c2e9")
	)
	(text "J1 is the ONLY power inlet: 12 V 30 A straight from the supply. Q1-Q4 block a reversed supply; every"
		(exclude_from_sim no)
		(at 20 214 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "e6d3421b-bf37-4f44-a1db-a5f63c2e591a")
	)
	(text "output is individually fused by an MF-R600 PPTC (6 A hold / 12 A trip) with a trip LED across it, and"
		(exclude_from_sim no)
		(at 20 219 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "f0e9d0fd-3fa6-4dd6-be32-9d1d485330e7")
	)
	(text "F0, a Keystone 3557-2 ATO holder, fuses the whole board at 30 A. No marine fuse panel is needed."
		(exclude_from_sim no)
		(at 20 224 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "6a4f3451-8f7a-4ba8-bc8d-a18b979821a1")
	)
	(text "No MCU: the fan thermostat and the over-temp LED are an NTC and one comparator. The two LM75s are"
		(exclude_from_sim no)
		(at 20 229 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "2956b807-9834-4419-8d75-77ea68f7d62d")
	)
	(text "passengers on the I2C header and run from the master's own VIO, so no level shifting is ever needed."
		(exclude_from_sim no)
		(at 20 234 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "2e3fafa1-83a8-4712-ab02-f2f3a0f5c646")
	)
	(text "Data ports J2 (P1), J5 (P2), J8 (P3), J11 (P4). The eight INJ terminals feed power only:"
		(exclude_from_sim no)
		(at 400 20 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "4a9925ee-5232-4539-b6be-93b2bcbcb6d7")
	)
	(text "their middle pole is a no-connect so an injection pigtail's data wire never becomes a stub on the string."
		(exclude_from_sim no)
		(at 400 25 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "9e093097-f7c7-43a1-99d4-8ee35f512e9b")
	)
	(text "Terminal poles are silk marked + / D / - and read left to right in that order on both rows of the board."
		(exclude_from_sim no)
		(at 400 30 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "bfd5d1bb-f413-4e67-813c-8cf3d4007504")
	)
