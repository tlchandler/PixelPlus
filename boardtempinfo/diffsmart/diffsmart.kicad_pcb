	(footprint "diffsmart:PiRibbon_2x20_P2.54mm"
		(layer "F.Cu")
		(uuid "148a39d2-b789-4279-8f35-dab1be70126a")
		(at 132.77 97.5 -90)
		(descr "2x20 2.54 mm male header (JLC C50980) for a 40-way ribbon to a Raspberry Pi. Pads are 1.4 mm rather than the vendor's 1.6 so the pin field can be routed out of; the 1.0 mm drill still leaves a 0.2 mm annular ring. Numbering is the vendor's own, straight through - NOT the swapped numbering of the socket this replaced, because a ribbon maps pin n to pin n. The same holes take a shrouded DC3-40P box header, which is keyed; the board keeps its shroud footprint clear.")
		(property "Reference" "J17"
			(at 29.5 -6.23 0)
			(layer "F.SilkS")
			(uuid "cf7bbd78-46cc-4a31-9d40-a4c4b77dea63")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Value" "2x20 hdr, Pi ribbon"
			(at 0 5.27 270)
			(layer "F.Fab")
			(hide yes)
			(uuid "0ecc4cf3-25c3-4144-ad6e-2aba0022deb5")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Datasheet" ""
			(at 0 0 270)
			(layer "F.Fab")
			(hide yes)
			(uuid "a92f14e3-1bbf-4e1c-b090-6d2f49f5dd8e")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "2x20 2.54 mm MALE header for a 40-way ribbon to a Raspberry Pi. The Pi is not part of the assembly and JLCPCB does not supply it. Pin numbering is straight through, so a standard ribbon maps board pin n to Pi pin n - watch the pin 1 marker, because a plain header can be plugged on either way round and reversed puts 5 V on GPIO2. The same holes take a shrouded DC3-40P box header if you would rather have the key; there is clearance for the shroud"
