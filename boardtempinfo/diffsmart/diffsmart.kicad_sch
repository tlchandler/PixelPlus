		(property "Description" "Holds DPI_D0 low. 2 k, not 10 k: GPIO4 comes out of reset with the Pi's internal pull-up enabled and keeps it for the whole boot, and 10 k against a 33 k pull-up sits at 0.77 V - 30 mV under the 74HCT125's 0.8 V V_IL. 2 k gives 0.19 V"
			(at 571.5 368.3 0)
			(show_name no)
			(do_not_autoplace no)
			(hide yes)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)

