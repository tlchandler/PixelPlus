	(text "diffsmart v1.00: RS-422 receiver OR Pi-hosted smart controller, plus 12 V / 30 A pixel power distribution"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 3.0 3.0)
			)
			(justify left bottom)
		)
		(uuid "f451931d-e391-4ec8-bef4-a39a38216db0")
	)
	(text "Companion to difftx (FPP Remote pHAT). Cat5 in on J14; four WS2811 data outputs; twelve fused 12 V outputs."
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "fc3c5a60-b55f-48c4-9a35-0bdf92c1bb4c")
	)
	(text "RJ45 pairs (Falcon): port1 = 1(+)/2(-), port2 = 3(+)/6(-), port3 = 5(+)/4(-), port4 = 7(+)/8(-). difftx rev D has port 3 reversed."
		(exclude_from_sim no)
		(at 20 29 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "dd998571-b7d4-4ad1-ac6e-49e3b608ee02")
	)
	(text "J1 is the ONLY power inlet: 12 V 30 A straight from the supply. Q1-Q4 block a reversed supply; every"
		(exclude_from_sim no)
		(at 20 214 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "a50a88c1-3fcf-4f5c-b39a-0d75de71fb84")
	)
	(text "output is individually fused by an MF-R600 PPTC (6 A hold / 12 A trip) with a trip LED across it, and"
		(exclude_from_sim no)
		(at 20 219 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "cdb67daf-24ad-4277-b7a2-3cab77ccdb55")
	)
	(text "F0, a Keystone 3557-2 ATO holder, fuses the whole board at 30 A. No marine fuse panel is needed."
		(exclude_from_sim no)
		(at 20 224 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "5a791687-f035-432c-b7f7-b20db1e68996")
	)
	(text "No MCU: the fan thermostat and the over-temp LED are an NTC and one comparator. The two LM75s are"
		(exclude_from_sim no)
		(at 20 229 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "ea02de47-0dd9-466e-aacc-aaa3922e6a5a")
	)
	(text "passengers on the I2C header and run from 3.3 V, the same rail the Pi's GPIO uses, so no level shifting is needed."
		(exclude_from_sim no)
		(at 20 234 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "67321289-38da-4f27-b7ba-bde571e27ce5")
	)
	(text "Data ports J2 (P1), J5 (P2), J8 (P3), J11 (P4). The eight INJ terminals feed power only:"
		(exclude_from_sim no)
		(at 400 20 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "7fe318a9-7b99-4c88-97fd-4f1a663309ae")
	)
	(text "their middle pole is a no-connect so an injection pigtail's data wire never becomes a stub on the string."
		(exclude_from_sim no)
		(at 400 25 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "0537956c-4928-40d8-9a5c-4492c5bcdf7b")
	)
	(text "Terminal poles are silk marked + / D / - and read left to right in that order on both rows of the board."
		(exclude_from_sim no)
		(at 400 30 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "2df8c21c-63d6-4fde-a044-ee8ad0019a08")
	)
