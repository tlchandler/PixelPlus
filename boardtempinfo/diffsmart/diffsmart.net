			(footprint "jlc:SOIC-8_L4.9-W3.9-P1.27-LS6.0-BL")
			(datasheet "https://www.lcsc.com/datasheet/C6482.pdf")
			(description "User EEPROM at 0x50 on i2c-1, clear of the LM75s at 0x48 and 0x49. NOT a HAT ID EEPROM: the Pi's firmware reads that only on ID_SD/ID_SC, pins 27 and 28, which this socket leaves unconnected, so there is no overlay and no HAT detection - read it with i2cdump -y 1 0x50. WP is tied low so it can be flashed in place; it runs from the Pi's own 3V3, so it is simply absent without a Pi")
			(fields
				(field
					(name "LCSC") "C6482")
				(field
					(name "Footprint") "jlc:SOIC-8_L4.9-W3.9-P1.27-LS6.0-BL")
