	(text "FPP Remote pHAT for Raspberry Pi Zero 2 W: 4-port RS-422 (Falcon differential) pixel driver, rev C"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left bottom)
		)
		(uuid "cbc1317a-f0c7-4f58-bd43-9dd7de46733a")
	)
	(text "Pi mounts under this board on 11 mm standoffs (M2.5 holes H1-H4, 58 x 23 mm). Power: 12 V in on J4 -> F1 -> D1 -> U4 -> 5 V onto Pi pins 2/4."
		(exclude_from_sim no)
		(at 20 23 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "708ab654-b631-4a47-a846-2ba151495b72")
	)
	(text "NEVER power the Pi from its USB while 12 V is connected (a Pi Zero has no diode between its USB 5 V input and the header 5 V pins)."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "b074ce49-2155-472a-8f9e-5cd5c80a7f47")
	)
	(text "FPP: cape EEPROM U3 on i2c-1 @0x50 (fppcapedetect registers a 24c256). DPIPixels strings: port1=P1-31, port2=P1-26, port3=P1-29, port4=P1-7."
		(exclude_from_sim no)
		(at 20 31 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
