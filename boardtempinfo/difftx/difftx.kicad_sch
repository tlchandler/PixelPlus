	(text "FPP Remote pHAT for Raspberry Pi Zero 2 W: 4-port RS-422 (Falcon differential) pixel driver, rev E (65 x 30 mm, same outline as the Pi Zero)"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left bottom)
		)
		(uuid "f9442ecd-a723-4f7e-989b-be28b7032f15")
	)
	(text "Pi mounts under this board on 11 mm standoffs (M2.5 holes H1-H4, 58 x 23 mm). Power: 12 V in on J4 -> F1 -> D1 -> U4 -> 5 V onto Pi pins 2/4."
		(exclude_from_sim no)
		(at 20 23 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "8d023af2-fdcc-46da-a1be-4d1ff0d22161")
	)
	(text "NEVER power the Pi from its USB while 12 V is connected (a Pi Zero has no diode between its USB 5 V input and the header 5 V pins)."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c2fb43b1-9870-4302-b2e8-f25aeac82d79")
	)
	(text "FPP: cape EEPROM U3 on i2c-1 @0x50 (fppcapedetect registers a 24c256). DPIPixels strings: port1=P1-29, port2=P1-31, port3=P1-26, port4=P1-7."
		(exclude_from_sim no)
		(at 20 31 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "03ad790a-5243-4503-9154-a191ac66e339")
	)
	(text "RJ45: port1 = pins 1(+),2(-)  port2 = 3(+),6(-)  port3 = 5(+),4(-)  port4 = 7(+),8(-).  Y = +, Z = -.  Driver enables G and ~G tied low."
		(exclude_from_sim no)
		(at 20 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "0e4b87df-a118-4104-b261-a52d49595ec2")
	)
	(text "JP1 open (default): EEPROM writable so FPP can program and sign it in place. Close JP1 afterwards to write-protect (WP high)."
		(exclude_from_sim no)
		(at 20 39 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "9c5403f0-2461-42f9-9d11-2d80293d5045")
	)
