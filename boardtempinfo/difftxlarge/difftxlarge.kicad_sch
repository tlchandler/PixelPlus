	(text "difftxlarge rev A - 60-output FPP DPIPixels cape: 15 x RJ45 (Falcon differential), 3 latch banks"
		(exclude_from_sim no)
		(at 20 12 0)
		(effects
			(font
				(size 3.0 3.0)
			)
			(justify left bottom)
		)
		(uuid "9827c36b-c87f-4c75-8418-f16f0c18506f")
	)
	(text "Output k (FPP port k+1, 0-based k): bank k//20, data line D(k%20) = GPIO(4 + k%20), jack J(k//4+1), port k%4+1."
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "01b0323f-4ca2-4235-9d83-62a66f948ada")
	)
	(text "Latch enables: LE0 = GPIO27 (P1-13) -> J1-J5, LE1 = GPIO26 (P1-37) -> J6-J10, LE2 = GPIO25 (P1-22) -> J11-J15."
		(exclude_from_sim no)
		(at 20 22 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "0d220bf8-8251-435a-b55c-9b15bc191625")
	)
	(text "RJ45: port1 = 1(+)/2(-), port2 = 3(+)/6(-), port3 = 5(+)/4(-), port4 = 7(+)/8(-). Falcon standard (difftx rev D had port 3 reversed)."
		(exclude_from_sim no)
		(at 20 26 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "fafef437-e4d3-4e35-9298-b3a270ac97e6")
	)
	(text "The Pi is powered from J18 (USB-C out, 5.1 V) through its own USB-C input, never through the ribbon."
		(exclude_from_sim no)
		(at 700 12 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "db11fdf0-1a65-4359-8f83-b3d671791e82")
	)
