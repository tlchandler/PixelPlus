<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Gives the pkexec password prompt a clear message when PixelPlus Imager (installed
     from the .deb/.rpm) writes an SD card. The AppImage works without it (generic prompt). -->
<policyconfig>
  <vendor>PixelPlus</vendor>
  <vendor_url>https://github.com/tlchandler/PixelPlus</vendor_url>
  <action id="org.pixelplus.imager.write">
    <description>Write a PixelPlus SD card</description>
    <message>PixelPlus Imager needs your permission to erase and write the SD card.</message>
    <icon_name>drive-removable-media</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/pixelplus-imager</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
