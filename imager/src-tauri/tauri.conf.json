{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelPlus Imager",
  "version": "0.1.0",
  "identifier": "org.pixelplus.imager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PixelPlus Imager",
        "width": 920,
        "height": 740,
        "minWidth": 720,
        "minHeight": 600,
        "backgroundColor": "#0a0b0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Write and pre-configure PixelPlus SD cards",
    "longDescription": "PixelPlus Imager downloads PixelPlus, writes it to a microSD card, verifies it and stores your Wi-Fi and controller settings on the card so the Raspberry Pi is ready at first boot.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["pkexec | policykit-1", "util-linux"],
        "files": {
          "/usr/share/polkit-1/actions/org.pixelplus.imager.policy": "linux/org.pixelplus.imager.policy"
        }
      },
      "rpm": {
        "depends": ["polkit", "util-linux"],
        "files": {
          "/usr/share/polkit-1/actions/org.pixelplus.imager.policy": "linux/org.pixelplus.imager.policy"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
