#!/bin/bash
# PixelPlus privileged helper. Runs as root via pixelplus-helper@<verb>.service, which
# the unprivileged pixelplusd starts with:
#     systemctl start --no-block 'pixelplus-helper@<verb>.service'
# (allowed by /usr/share/polkit-1/rules.d/50-pixelplus.rules).
#
# Verbs (arguments are ':'-separated inside the instance name):
#   config-txt:<board>[:<pixels>]  regenerate /boot/firmware/pixelplus.conf (the board's
#                               boot settings, included from config.txt) via
#                               `pixelplus config-txt --board <board> [--pixels N]`.
#                               Does NOT reboot: pixelplusd asks the user, then reboots via logind.
#   update                      apt-get update + upgrade the pixelplus package, restart
#   refresh-index               apt-get update only (the update check reads the package
#                               lists; PixelPlus images disable apt's own daily timers)
#   ssh-on | ssh-off            enable / disable the SSH server
#   reapply                     re-apply /boot/firmware/pixelplus.txt now
#   wifi-country:<CC>           set the Wi-Fi regulatory country (two letters)
#   hosts                       point /etc/hosts' 127.0.1.1 line at the current hostname
#                               (pixelplusd changes the hostname itself via hostnamed)
#
# Progress/result is written to /run/pixelplus/helper-<verb>.json for the UI to poll:
#   {"verb": "...", "state": "running|ok|failed", "message": "...", "updatedAt": <unix>}
# /run/pixelplus is writable by the pixelplus user, so the file is written in a root-only
# directory first and then renamed into place (rename never follows a planted symlink).
set -euo pipefail

readonly STATUS_DIR="${PIXELPLUS_HELPER_STATUS_DIR:-/run/pixelplus}"
readonly PRIVATE_DIR="${PIXELPLUS_HELPER_PRIVATE_DIR:-/run/pixelplus-helper}"
readonly FIRSTBOOT="${PIXELPLUS_FIRSTBOOT:-/usr/lib/pixelplus/firstboot/firstboot.py}"
readonly HOSTS_FILE="${PIXELPLUS_HOSTS_FILE:-/etc/hosts}"
readonly APT_GET="${PIXELPLUS_APT_GET:-apt-get}"

instance="${1:-}"
IFS=':' read -r verb arg1 arg2 extra <<<"${instance}"
extra="${extra:-}"

status() {
    local state="$1" msg="$2" tmp
    mkdir -p "${STATUS_DIR}"
    [[ -d "${PRIVATE_DIR}" ]] || mkdir -m 0700 "${PRIVATE_DIR}"
    # message is escaped for JSON (backslashes, quotes; control characters become spaces)
    msg="${msg//\\/\\\\}"
    msg="${msg//\"/\\\"}"
    msg="${msg//[$'\t\r\n']/ }"
    tmp="$(mktemp "${PRIVATE_DIR}/helper-${verb}.XXXXXX")"
    printf '{"verb":"%s","state":"%s","message":"%s","updatedAt":%s}\n' \
        "${verb}" "${state}" "${msg}" "$(date +%s)" >"${tmp}"
    chmod 0644 "${tmp}"
    # same filesystem (/run): an atomic rename that replaces whatever is at the target name
    mv -fT "${tmp}" "${STATUS_DIR}/helper-${verb}.json" || rm -f "${tmp}"
}

fail() {
    echo "pixelplus-helper: $*" >&2
    status failed "$*"
    exit 1
}

valid_token() { [[ "$1" =~ ^[A-Za-z0-9._-]{1,32}$ ]]; }

[[ -n "${extra}" ]] && { verb="invalid"; fail "too many arguments"; }
valid_token "${verb:-}" || { verb="invalid"; fail "missing or invalid verb"; }

case "${verb}" in
config-txt)
    valid_token "${arg1:-}" || fail "invalid board id"
    args=(board-config --board "${arg1}")
    if [[ -n "${arg2:-}" ]]; then
        [[ "${arg2}" =~ ^[0-9]{1,5}$ ]] || fail "invalid pixel count"
        args+=(--pixels "${arg2}")
    fi
    status running "Writing board settings for ${arg1}"
    if /usr/bin/python3 "${FIRSTBOOT}" "${args[@]}"; then
        status ok "Board settings for ${arg1} saved; restart the controller to use them"
    else
        fail "Could not write board settings (see /var/log/pixelplus-firstboot.log)"
    fi
    ;;
update)
    [[ -z "${arg1:-}" ]] || fail "update takes no arguments"
    status running "Checking for updates"
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -q || fail "apt-get update failed (no internet?)"
    status running "Installing update"
    apt-get install -y -q --only-upgrade \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
        pixelplus || fail "Installing the update failed"
    status ok "Up to date: $(dpkg-query -W -f='${Version}' pixelplus 2>/dev/null || echo unknown)"
    # postinst restarts pixelplusd
    ;;
refresh-index)
    [[ -z "${arg1:-}" ]] || fail "refresh-index takes no arguments"
    status running "Checking for updates"
    export DEBIAN_FRONTEND=noninteractive
    "${APT_GET}" update -q || fail "Couldn't check for updates (no internet?)"
    status ok "Package lists refreshed"
    ;;
ssh-on | ssh-off)
    [[ -z "${arg1:-}" ]] || fail "${verb} takes no arguments"
    if command -v raspi-config >/dev/null 2>&1; then
        raspi-config nonint do_ssh "$([[ ${verb} == ssh-on ]] && echo 0 || echo 1)"
    elif [[ ${verb} == ssh-on ]]; then
        systemctl enable --now ssh.service
    else
        systemctl disable --now ssh.service
    fi
    status ok "SSH ${verb#ssh-}"
    ;;
reapply)
    [[ -z "${arg1:-}" ]] || fail "reapply takes no arguments"
    status running "Applying pixelplus.txt"
    /usr/bin/python3 "${FIRSTBOOT}" apply --force --no-reboot || fail "re-apply failed"
    status ok "pixelplus.txt applied"
    ;;
wifi-country)
    [[ "${arg1:-}" =~ ^[A-Za-z]{2}$ ]] || fail "invalid Wi-Fi country (two letters, like US)"
    [[ -z "${arg2:-}" ]] || fail "wifi-country takes one argument"
    cc="${arg1^^}"
    status running "Setting the Wi-Fi country to ${cc}"
    if command -v raspi-config >/dev/null 2>&1; then
        raspi-config nonint do_wifi_country "${cc}" || fail "Could not set the Wi-Fi country to ${cc}"
    else
        iw reg set "${cc}" || fail "Could not set the Wi-Fi country to ${cc}"
        rfkill unblock wifi || true
    fi
    status ok "Wi-Fi country set to ${cc}"
    ;;
hosts)
    [[ -z "${arg1:-}" ]] || fail "hosts takes no arguments"
    name="$(hostnamectl --static 2>/dev/null || hostname)"
    [[ "${name}" =~ ^[A-Za-z0-9-]{1,63}$ ]] || fail "unexpected hostname '${name}'"
    tmp_hosts="$(mktemp "${HOSTS_FILE}.pixelplus.XXXXXX")"
    if [[ -f "${HOSTS_FILE}" ]]; then
        grep -Ev '^[[:space:]]*127\.0\.1\.1[[:space:]]' "${HOSTS_FILE}" >"${tmp_hosts}" || true
    fi
    printf '127.0.1.1\t%s\n' "${name}" >>"${tmp_hosts}"
    chmod 0644 "${tmp_hosts}"
    mv -f "${tmp_hosts}" "${HOSTS_FILE}"
    # cloud-init (Trixie images) would reset the hostname at the next boot otherwise
    if [[ -d /etc/cloud/cloud.cfg.d && -z "${PIXELPLUS_HOSTS_FILE:-}" ]]; then
        printf '# Written by PixelPlus: hostname is managed by pixelplus.txt / the PixelPlus UI\npreserve_hostname: true\n' \
            >/etc/cloud/cloud.cfg.d/99-pixelplus-hostname.cfg
    fi
    status ok "/etc/hosts points at ${name}"
    ;;
*)
    fail "unknown verb '${verb}'"
    ;;
esac
