[Unit]
Description=PixelPlus text-to-speech sidecar (Kokoro, loopback :7081)
Documentation=https://github.com/tlchandler/PixelPlus/blob/main/docs/ARCHITECTURE.md
After=network.target
PartOf=pixelplusd.service
# Only installed on images/hosts that have the venv...
ConditionPathExists=/opt/pixelplus-tts/venv/bin/python

[Service]
Type=simple
# Its own user without polkit rights. It reads music beds from media/ (group pixelplus)
# and keeps its models in tts/; nothing else of the data directory is visible.
User=pixelplus-tts
Group=pixelplus-tts
SupplementaryGroups=pixelplus
# ...and only worth running on a Pi 4/5 (>= 2 GB) or a PC (amd64). Exit 1 = skip.
ExecCondition=/usr/lib/pixelplus/tts-capable
Environment=PIXELPLUS_DATA_DIR=/var/lib/pixelplus
Environment=PIXELPLUS_TTS_HOST=127.0.0.1
Environment=PIXELPLUS_TTS_PORT=7081
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/pixelplus
WorkingDirectory=/opt/pixelplus-tts
ExecStart=/opt/pixelplus-tts/venv/bin/python -m pixelplus_tts serve
Restart=on-failure
RestartSec=10
# Never steal CPU from the pixel output thread.
Nice=10
CPUWeight=40
IOWeight=40
MemoryHigh=900M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
TemporaryFileSystem=/var/lib/pixelplus:ro /dev/shm
BindReadOnlyPaths=-/var/lib/pixelplus/media
BindPaths=/var/lib/pixelplus/tts
InaccessiblePaths=-/run/pixelplus -/run/pixelplus-games
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
